load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_library", "go_test", "nogo")

# gazelle:prefix github.com/advdv/connectmcp-go
# gazelle:proto disable_global
# gazelle:exclude pkg/testdata/gen/go/google
# gazelle:exclude pkg/testdata/gen/go/buf
# gazelle:exclude pkg/testdata/proto
# external_llm gates the live-provider conformance tests; declare it so gazelle
# emits their go_test target. The tag is enabled for bazel test in .bazelrc, and
# the tests still self-skip unless the provider API keys are present.
# gazelle:build_tags external_llm
gazelle(name = "gazelle")

